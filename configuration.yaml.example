# Example configuration for Loewe TV integration
# Add this to your configuration.yaml file

media_player:
  - platform: loewe_tv
    host: 192.168.1.100  # Replace with your Loewe TV IP address
    mac: "AA:BB:CC:DD:EE:FF"  # Replace with your Loewe TV MAC address
    name: "Living Room TV"  # Optional: Custom name for your TV

# Optional: Enable debug logging
# logger:
#   default: info
#   logs:
#     custom_components.loewe_tv: debug
